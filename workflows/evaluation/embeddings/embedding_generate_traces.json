    {
      "parameters": {
        "jsCode": "const startTime = $('Establecer Tiempo Inicial de la Consulta').first().json.start_time_ms * 1000000;\nconst now = Date.now();\nconst endTime = now * 1000000;\n\n// Obtenemos todos los resultados que devolvió Pinecone\nconst items = $input.all();\n\n// Mapeamos a una estructura limpia para Guardar en Langfuse\nconst retrievalTrace = items.map((item, index) => {\n  const doc = item.json.document;\n\n  return {\n    rank: index + 1,\n    score: item.json.score,\n    answer: doc.metadata.answer\n  };\n});\n\nreturn {\n  json: {\n    retrieval_output: retrievalTrace,\n    start_time_nano: startTime,\n    end_time_nano: endTime\n  }\n};"
      },
