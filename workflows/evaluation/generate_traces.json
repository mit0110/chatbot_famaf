        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"resourceSpans\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          { \"key\": \"service.name\", \"value\": { \"stringValue\": \"n8n-chatbot\" } }\n        ]\n      },\n      \"scopeSpans\": [\n        {\n          \"scope\": { \"name\": \"n8n-workflow\" },\n          \"spans\": [\n            {\n              \"traceId\": \"{{ $json.otel_trace_id }}\", \n              \"spanId\": \"{{ $json.otel_span_id }}\", \n              \"name\": \"{{ $('Establecer Nombre de las Trazas').item.json.trace_name }}\",\n              \"kind\": 2, \n              \"startTimeUnixNano\": \"{{ $json.start_time_nano }}\",\n              \"endTimeUnixNano\": \"{{ $json.end_time_nano }}\",\n              \"attributes\": [\n                { \"key\": \"input.value\", \"value\": { \"stringValue\": {{ JSON.stringify($('Ciclo sobre Todas las Entradas').item.json.input) }} } },\n                { \"key\": \"output.value\", \"value\": { \"stringValue\": {{ JSON.stringify($('Pinecone Vector Store').item.json.document.metadata.Answer)}} }},\n                {\n                  \"key\": \"retrieval.score\",\n                  \"value\": {\n                    \"doubleValue\": {{ $('Pinecone Vector Store').item.json.score }}\n                  }\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
