    {
      "parameters": {
        "jsCode": "// 1. Get the current \"actual\" question from the Telegram Trigger node\nconst actualQuestion = $('Ciclo sobre Todas las Entradas').first().json.input\nconsole.log(actualQuestion)\n// 2. Get the historical data from the previous Redis Get node\nlet rawHistory = $input.first().json.propertyName;\n\nlet historyArray = [];\n\n// 3. Parse the Redis history string into an array of objects\nif (typeof rawHistory === 'string' && rawHistory !== 'none') {\n  try {\n    const parsed = JSON.parse(rawHistory);\n    // Since history is saved as an object {q1:..., q2:...}, extract the values\n    historyArray = Object.values(parsed);\n  } catch (e) {\n    historyArray = [];\n  }\n}\n\n// 4. Sort history by timestamp (Newest to Oldest) to ensure correct order\n//historyArray.sort((a, b) => new Date(b.timestamp) - new //Date(a.timestamp));\n\nlet result = {};\n\n// 5. ALWAYS set q1 as the actual question from the current Telegram message\nresult['q1'] = {\n  \"question\": actualQuestion,\n  \"timestamp\": new Date().toISOString()\n};\n\n// 6. Fill q2 through q5 with the 4 most recent historical questions (if they exist)\nhistoryArray.slice(0, 4).forEach((item, index) => {\n  result[`q${index + 2}`] = item;\n});\n\nreturn { json: result };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
