        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"resourceSpans\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          { \"key\": \"service.name\", \"value\": { \"stringValue\": \"n8n-chatbot\" } }\n        ]\n      },\n      \"scopeSpans\": [\n        {\n          \"scope\": { \"name\": \"n8n-workflow\" },\n          \"spans\": [\n            {\n              \"traceId\": \"{{ $('Generar Datos Necesarios para OTLP').item.json.otel_trace_id }}\", \n              \"spanId\": \"{{ $('Generar Datos Necesarios para OTLP').item.json.otel_span_id }}\", \n              \"name\": \"{{ $('Al ser Ejecutado por Otro Workflow').first().json.trace_name }}\",\n              \"kind\": 1, \n              \"startTimeUnixNano\": \"{{ $('Formateo para Guardar Traza').item.json.start_time_nano }}\",\n              \"endTimeUnixNano\": \"{{ $('Formateo para Guardar Traza').item.json.end_time_nano }}\",\n              \"attributes\": [\n                { \"key\": \"input.value\", \"value\": { \"stringValue\": \"{{ $('Ciclo sobre Todas las Entradas').first().json.input }}\" } },\n                { \"key\": \"output.value\", \"value\": { \"stringValue\": {{ JSON.stringify($('Generar Datos Necesarios para OTLP').item.json.otel_output) }}} },\n                {\n                  \"key\": \"top_k\", \"value\": { \"intValue\": 5 }\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
