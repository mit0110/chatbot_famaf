              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"resourceSpans\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          {\n            \"key\": \"service.name\",\n            \"value\": {\n              \"stringValue\": \"n8n-chatbot\"\n            }\n          }\n        ]\n      },\n      \"scopeSpans\": [\n        {\n          \"scope\": {\n            \"name\": \"n8n-workflow\"\n          },\n          \"spans\": [\n            {\n              \"traceId\": \"{{ $json.otel_trace_id }}\",\n              \"spanId\": \"{{ $json.otel_span_id }}\",\n              \"name\": \"embedding-costs-v1-{{ $('Establecer Nombre del Modelo de Embedding').first().json.supplier }}-{{ $('Establecer Nombre del Modelo de Embedding').first().json.embedding_model_name }}\",\n              \"kind\": 0,\n              \"startTimeUnixNano\": {{ $json.start_time_nano }},\n              \"endTimeUnixNano\": {{ $json.end_time_nano }},\n              \"attributes\": [\n                {\n                  \"key\": \"input.value\",\n                  \"value\": {\n                    \"stringValue\": {{ JSON.stringify($('Ciclo sobre Todas las Entradas').first().json.input) }}\n                  }\n                },\n                {\n                  \"key\": \"output.value\",\n                  \"value\": {\n                    \"stringValue\": {{ $if($('HTTP Request API de Pinecone (Gemini)').isExecuted, JSON.stringify($('HTTP Request API de Pinecone (Gemini)').item.json.matches[0].metadata.answer), JSON.stringify($('HTTP Request API de Pinecone (Ollama)').item.json.matches[0].metadata.answer)) }}\n                  }\n                },\n                {\n                  \"key\": \"gen_ai.system\",\n                  \"value\": {\n                    \"stringValue\": \"{{ $('Establecer Nombre del Modelo de Embedding').first().json.supplier }}\"\n                  }\n                },\n                {\n                  \"key\": \"gen_ai.request.model\",\n                  \"value\": {\n                    \"stringValue\": \"{{ $('Establecer Nombre del Modelo de Embedding').first().json.embedding_model_name }}\"\n                  }\n                },\n                {\n                  \"key\": \"gen_ai.usage.input_tokens\",\n                  \"value\": {\n                    \"intValue\": {{ $if($('HTTP Request API de Pinecone (Gemini)').isExecuted, $('HTTP Request Google API para Contar Tokens').item.json.promptTokensDetails[0].tokenCount, $('HTTP Request de Embeddings para CCAD').item.json.usage.prompt_tokens) }}\n                  }\n                },\n                {\n                  \"key\": \"gen_ai.usage.completion_tokens\",\n                  \"value\": {\n                    \"intValue\": 0\n                  }\n                },\n                {\n                  \"key\": \"gen_ai.usage.total_tokens\",\n                  \"value\": {\n                    \"intValue\": {{ $if($('HTTP Request de Embeddings para CCAD').isExecuted, $('HTTP Request de Embeddings para CCAD').item.json.usage.total_tokens, $('HTTP Request Google API para Contar Tokens').item.json.totalTokens) }}\n                  }\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
