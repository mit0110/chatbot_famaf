      "parameters": {
        "jsCode": "const ragOutput = $('Agente RAG').first().json;\nconst responseType = ragOutput.output.response_type;\n\nlet response = null;\nlet score = $('Clear response').first().json.data[0].score;\n\n// Set output.value based on response_type\nif (responseType === 'canned_answer') {\n  score = $('Canned answer').first().json.score;\n  response = $('Canned answer').first().json.response;\n} else if (responseType === 'fallback') {\n  response = $('fallback').first().json.response;\n} else if (responseType === 'human_needed') {\n  response = $('Redireccionar a un humano').first().json.response;\n} else {\n  // Parar el workflow con un error\n  throw new Error(`Tipo de respuesta no reconocido: ${responseType}`);\n}\n\nreturn [{ \n  json: {\n    response: response,\n    score: score\n  }\n}];"
