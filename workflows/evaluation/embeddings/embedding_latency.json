      "parameters": {
        "jsCode": "// 1. Recuperar datos (ajusta los nombres de nodos si es necesario)\nconst pineconeName = $('Crear índice en Pinecone').first().json.name;\nconst timeMs = $input.first().json.embedding_time_ms\nconst date = new Date().toISOString();\n\n// 2. Crear la línea de texto (IMPORTANTE: el \\n al final es el salto de línea)\nconst csvLine = `${date},${pineconeName},${timeMs}\\n`;\n\n// 3. Devolverlo como JSON\nreturn {\n  json: {\n    texto_para_csv: csvLine\n  }\n};"
      },
