    {
      "parameters": {
        "method": "POST",
        "url": "https://us.cloud.langfuse.com/api/public/otel/v1/traces",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"resourceSpans\": [\n    {\n      \"resource\": {\n        \"attributes\": [\n          { \"key\": \"service.name\", \"value\": { \"stringValue\": \"n8n-chatbot\" } }\n        ]\n      },\n      \"scopeSpans\": [\n        {\n          \"scope\": { \"name\": \"n8n-workflow\" },\n          \"spans\": [\n            {\n              \"traceId\": \"{{ $json.otel_trace_id }}\", \n              \"spanId\": \"{{ $json.otel_span_id }}\", \n              \"name\": \"canned-responses\",\n              \"kind\": 2, \n              \"startTimeUnixNano\": \"{{ $json.start_time_nano }}\",\n              \"endTimeUnixNano\": \"{{ $json.end_time_nano }}\",\n              \"attributes\": [\n                { \"key\": \"input.value\", \"value\": { \"stringValue\": {{ JSON.stringify($('Ciclo sobre Todas las Entradas').item.json.input) }} } },\n                { \"key\": \"output.value\", \"value\": { \"stringValue\": {{ JSON.stringify($('Pinecone Vector Store').item.json.document.metadata.Answer)}} }}\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
