      "parameters": {
        "jsCode": "function generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\n// Pasar tiempos a nano\nconst startTime = $('Establecer Tiempo Inicial de Consulta').first().json.query_start_time * 1000000;\nconst now = Date.now();\nconst endTime = now * 1000000;\n\n// Generamos los IDs basándonos en UUID v4\nconst uuidTrace = generateUUID(); // Formato: xxxxxxxx-xxxx-4xxx...\nconst uuidSpan = generateUUID();\n\n// OpenTelemetry exige Hexadecimal seguido sin guiones\n// TraceID: 32 chars (quitamos los guiones al UUID completo)\nconst traceId = uuidTrace.replace(/-/g, ''); \n\n// SpanID: 16 chars (tomamos solo los primeros 16 chars del segundo UUID sin guiones)\n// Nota: Un SpanID debe ser de 64 bits (16 hex chars).\nconst spanId = uuidSpan.replace(/-/g, '').substring(0, 16);\n\nreturn {\n  json: {\n    otel_trace_id: traceId,\n    otel_span_id: spanId,\n    start_time: startTime,\n    end_time: endTime\n  }\n};"
      },
