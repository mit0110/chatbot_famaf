    {
      "parameters": {
        "jsCode": "// Función para generar un UUID v4 estándar (RFC 4122)\n// Esto asegura una distribución uniforme y evita colisiones prácticas\nfunction generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\n// 1. Tiempos en Nanosegundos\nconst startTime = $('Establecer Tiempo Inicial de la Consulta').first().json.start_time_ms * 1000000;\nconst now = Date.now();\nconst endTime = now * 1000000;\n\n// 2. Generamos los IDs basándonos en UUID v4\nconst uuidTrace = generateUUID(); // Formato: xxxxxxxx-xxxx-4xxx...\nconst uuidSpan = generateUUID();\n\n// 3. OpenTelemetry exige Hexadecimal seguido sin guiones\n// TraceID: 32 chars (quitamos los guiones al UUID completo)\nconst traceId = uuidTrace.replace(/-/g, ''); \n\n// SpanID: 16 chars (tomamos solo los primeros 16 chars del segundo UUID sin guiones)\n// Nota: Un SpanID debe ser de 64 bits (16 hex chars).\nconst spanId = uuidSpan.replace(/-/g, '').substring(0, 16);\n\nreturn {\n  json: {\n    otel_trace_id: traceId,\n    otel_span_id: spanId,\n    start_time_nano: startTime,\n    end_time_nano: endTime\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        1248
      ],
      "id": "fa96cbac-383e-4356-9d45-3c4b4ab4fe46",
