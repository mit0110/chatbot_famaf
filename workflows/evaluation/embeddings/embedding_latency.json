      "parameters": {
        "jsCode": "const startTime = $('Establecer Tiempo Inicial del Embedding').first().json.embedding_start_time\nconst endTime = Date.now();\n\nreturn {\n  json: {\n    // Tiempo en ms\n    embedding_time_ms: endTime - startTime\n  }\n};"
